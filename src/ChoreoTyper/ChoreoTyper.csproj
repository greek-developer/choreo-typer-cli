<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ChoreoTyper</RootNamespace>
    <Nullable>enable</Nullable>
    <PackageOutputPath>../../release</PackageOutputPath>
    <PackAsTool>true</PackAsTool>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

<PropertyGroup>  
  <Product>Choreo-Typer</Product>  
  <Copyright>2025 GRDEV</Copyright>
</PropertyGroup>

 <PropertyGroup>    
    <ToolCommandName>choreo-typer</ToolCommandName>
    <PackageId>grdev.choreo-typer-cli</PackageId>
    <Authors>Thomas Sarmis (thomas.sarmis@gmail.com), GRDEV</Authors>
    <Description>Keyboard automation tool for perfect keystrokes every time</Description>
    <RepositoryUrl>https://github.com/greek-developer/choreo-typer-cli</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://greekdeveloper.com/projects//choreo-typer</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\"/>        
  </ItemGroup>
</Project>
